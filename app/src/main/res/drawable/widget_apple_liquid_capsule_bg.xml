<?xml version="1.0" encoding="utf-8"?>
<!--
  Apple Liquid Glass Capsule / Dock Pill Background
  Wet, high-gloss fluid glass dock with glossy top reflection
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Soft Edge Scrim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#30000000" />
        </shape>
    </item>

    <!-- Specular Light Catch Rim -->
    <item
        android:bottom="0.7dp"
        android:left="0.7dp"
        android:right="0.7dp"
        android:top="0.7dp">
        <shape android:shape="rectangle">
            <corners android:radius="21.3dp" />
            <stroke
                android:width="1dp"
                android:color="#85FFFFFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>

    <!-- Liquid Glass Body with Vertical Gradient -->
    <item
        android:bottom="1.4dp"
        android:left="1.4dp"
        android:right="1.4dp"
        android:top="1.4dp">
        <shape android:shape="rectangle">
            <corners android:radius="20.6dp" />
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#08FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Specular Gloss Highlight Strip -->
    <item
        android:bottom="18dp"
        android:left="1.4dp"
        android:right="1.4dp"
        android:top="1.4dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="20.6dp"
                android:topRightRadius="20.6dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="#50FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
