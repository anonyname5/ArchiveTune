<?xml version="1.0" encoding="utf-8"?>
<!--
  Apple Liquid Glass Active Lyric Highlight
  Subtle, deep liquid refraction drop highlight that magnifies the current line
  with smooth ambient glow matching in-app Apple Music easing.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 0: Ambient Refraction Shadow / Soft Fluid Halo -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#18000000" />
        </shape>
    </item>

    <!-- Layer 1: Liquid Resin Dynamic Base Tint -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient
                android:angle="270"
                android:centerColor="#16FFFFFF"
                android:endColor="#22FFFFFF"
                android:startColor="#34FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 2: Subtle Specular Top Curve Glare -->
    <item
        android:bottom="6dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="15dp"
                android:topRightRadius="15dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#45FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 3: Perimeter Crystalline Prism Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke
                android:width="1.2dp"
                android:color="#60FFFFFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
