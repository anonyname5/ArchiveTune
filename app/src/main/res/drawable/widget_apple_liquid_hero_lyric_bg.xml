<?xml version="1.0" encoding="utf-8"?>
<!--
  Apple Liquid Glass Active Lyric Highlight
  Subtle, luminous liquid drop highlight that magnifies the current line
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle glowing boundary -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#55FFFFFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>

    <!-- Pure liquid optical sheen -->
    <item
        android:bottom="0.8dp"
        android:left="0.8dp"
        android:right="0.8dp"
        android:top="0.8dp">
        <shape android:shape="rectangle">
            <corners android:radius="13.2dp" />
            <gradient
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#18FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
