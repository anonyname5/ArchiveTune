<?xml version="1.0" encoding="utf-8"?>
<!--
  Apple Liquid Glass Stage Background for AppWidget
  Simulates true physical liquid glass:
  - Ambient deep refraction base
  - Wet specular top glare / lens curvature
  - Specular crystalline prism perimeter rim
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 0: Ambient Refraction Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <solid android:color="#45080A10" />
        </shape>
    </item>

    <!-- Layer 1: Crystalline Perimeter Specular Rim -->
    <item
        android:bottom="0.8dp"
        android:left="0.8dp"
        android:right="0.8dp"
        android:top="0.8dp">
        <shape android:shape="rectangle">
            <corners android:radius="29.2dp" />
            <stroke
                android:width="1.2dp"
                android:color="#75FFFFFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>

    <!-- Layer 2: Deep Liquid Resin Optical Body -->
    <item
        android:bottom="1.8dp"
        android:left="1.8dp"
        android:right="1.8dp"
        android:top="1.8dp">
        <shape android:shape="rectangle">
            <corners android:radius="28.2dp" />
            <gradient
                android:angle="270"
                android:startColor="#381E2333"
                android:centerColor="#24121624"
                android:endColor="#350B0E17"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 3: Top Curved Wet Specular Glare (The Liquid Lens Reflection) -->
    <item
        android:bottom="80dp"
        android:left="1.8dp"
        android:right="1.8dp"
        android:top="1.8dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="28.2dp"
                android:topRightRadius="28.2dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="#45FFFFFF"
                android:centerColor="#15FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
